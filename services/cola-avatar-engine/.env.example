# Required for authenticated network sessions; offline render needs no secrets.
AVATAR_JWT_SECRET=
AVATAR_JWT_ISSUER=shiba-live
AVATAR_JWT_AUDIENCE=shiba-avatar
AVATAR_ALLOWED_ORIGINS=http://localhost:8000
MODEL_DIR=models
# Optional when exactly one avatar package is installed.
AVATAR_ID=
MAX_SESSIONS=1
PORT=8000
# Configure ICE only after offline GPU acceptance.
# AVATAR_STUN_URL=stun:your-coturn-host:3478
# AVATAR_TURN_URL=turn:your-coturn-host:3478
# AVATAR_TURN_USERNAME=renderer-account
# AVATAR_TURN_PASSWORD=
